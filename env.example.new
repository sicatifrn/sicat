# =============================================================================
# SICAT — variáveis novas para login OAuth via SUAP
# Copie para o seu .env e preencha os valores.
# =============================================================================

# --- Banco e JWT (já existiam) ---
DATABASE_URL=mysql+pymysql://usuario:senha@127.0.0.1:3306/sicat
SECRET_KEY=sua-chave-secreta-aqui-altere-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=72

# --- SUAP OAuth (NOVO) ---
# URL base do SUAP da sua instituição
SUAP_API_URL=https://suap.ifrn.edu.br

# Copie do formulário "Aplicações OAuth" no SUAP (Client id / Client Secret)
SUAP_CLIENT_ID=cole_o_client_id_aqui
SUAP_CLIENT_SECRET=cole_o_client_secret_aqui

# Deve ser EXATAMENTE igual ao "Redirect URIs" cadastrado no SUAP.
# Desenvolvimento (backend na porta 7000):
SUAP_REDIRECT_URI=http://localhost:7000/api/auth/suap/callback
# Produção (exemplo):
# SUAP_REDIRECT_URI=https://api.seudominio.com/api/auth/suap/callback

# Escopos pedidos ao SUAP (espaço entre eles)
# identificacao + email = dados básicos; documentos_pessoais = CPF
SUAP_OAUTH_SCOPE=identificacao email documentos_pessoais

# URL do frontend — para onde o backend redireciona após login bem-sucedido
# Desenvolvimento (Vite):
FRONTEND_URL=http://localhost:5173
# Produção (exemplo):
# FRONTEND_URL=https://sicat.seudominio.com

# --- Admin (opcional) ---
ADMIN_MATRICULAS=20221041110028
ADMIN_SYNC_INTERVAL_SECONDS=300
ADMIN_SYNC_ENABLED=true
